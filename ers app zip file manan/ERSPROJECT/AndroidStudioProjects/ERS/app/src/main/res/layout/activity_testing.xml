<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="56dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Setup  3 / 3"
                android:textSize="13sp"
                android:textColor="@color/text_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 Test Trigger"
                android:textSize="13sp"
                android:textColor="@color/primary_light" />
        </LinearLayout>

        <!-- Main Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mainCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/dark_card"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="@color/glass_border"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <!-- Title -->
                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 Test Your Trigger"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <!-- Instruction Text -->
                <TextView
                    android:id="@+id/instructionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose your trigger button below, then tap Start Test to practice the hold gesture."
                    android:textSize="15sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="24dp" />

                <!-- Timer (shown during countdown) -->
                <TextView
                    android:id="@+id/timerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textSize="72sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone" />

                <!-- Status Text (shown during test) -->
                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ready..."
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/warning"
                    android:gravity="center"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone" />

                <!-- Start Test Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startTestButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="▶  Start Test"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    android:layout_marginBottom="12dp" />

                <!-- Skip Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/skipButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Skip Test"
                    android:textSize="14sp"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:textColor="@color/text_hint"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Settings Card (trigger type selector) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/dark_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CHOOSE TRIGGER BUTTON"
                    android:textSize="11sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="16dp" />

                <RadioGroup
                    android:id="@+id/triggerTypeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/volumeDownRadio"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="🔉  Volume Down — Hold 5 seconds"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary"
                        android:paddingStart="8dp"
                        android:layout_marginBottom="8dp" />

                    <RadioButton
                        android:id="@+id/volumeUpRadio"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="🔊  Volume Up — Hold 5 seconds"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary"
                        android:paddingStart="8dp" />

                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
