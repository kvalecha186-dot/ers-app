<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- External app-specific Music folder (primary recording location) -->
    <external-files-path name="external_files" path="/" />
    <external-files-path name="recordings"     path="Music/ERS_Recordings/" />

    <!-- Internal storage fallback (used when SD card is removed) -->
    <files-path name="internal_files"       path="/" />
    <files-path name="internal_recordings"  path="ERS_Recordings/" />

    <!-- Cache directories -->
    <cache-path name="cache"        path="/" />
    <external-cache-path name="external_cache" path="/" />

</paths>
